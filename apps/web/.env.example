# Indexer GraphQL endpoint, read by lib/graphql.ts. Unset means the indexer is
# treated as offline: the chart and the trade and holder lists are empty and
# every price, quote and fee still comes from the chain.
NEXT_PUBLIC_INDEXER_URL=

# Cloudflare R2 account id, which fixes the S3 endpoint host for uploads.
R2_ACCOUNT_ID=

# R2 access key id, used server side to sign the presigned upload PUT.
R2_ACCESS_KEY_ID=

# R2 secret for that key. Server side only, never sent to the browser.
R2_SECRET_ACCESS_KEY=

# R2 bucket holding the uploads/<sha256>/<size>.webp and metadata objects.
R2_BUCKET=

# Public origin those stored images are served from, with a long s-maxage.
R2_PUBLIC_BASE_URL=

# Upstash Redis REST endpoint, the counter store behind the API rate limits.
UPSTASH_REDIS_REST_URL=

# Upstash REST token for that endpoint. Server side only: it grants writes.
UPSTASH_REDIS_REST_TOKEN=

# Neon Postgres pooled connection string, the runtime connection through the
# pg driver adapter. Unset means the database is reported unconfigured and
# every route that needs it answers 503.
DATABASE_URL=

# Neon direct connection string. prisma migrate must bypass the pooled
# endpoint, and the Prisma CLI reads it from apps/web/.env through
# prisma.config.ts, not from .env.local.
DIRECT_URL=

# Optional shadow database for prisma migrate dev diffing on Neon. Neon needs
# a separate database for it, created once and named here.
SHADOW_DATABASE_URL=

# Deployed origin, e.g. https://peakpump.example. Fixes the domain the SIWE
# message must carry; a mismatch fails sign-in.
NEXTAUTH_URL=

# Secret encrypting and signing the session cookie. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
