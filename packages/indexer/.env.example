# Needed only for `envio deploy`, which publishes to the Envio-hosted testnet
# endpoint. Local indexing through `pnpm --filter @peakpump/indexer dev` needs no
# token at all: it reads the chain directly over hypersync.
# Create or update a token at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"
