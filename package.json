{
  "name": "peakpump",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "gen:vectors": "tsx contracts/test/reference/gen-vectors.ts",
    "gen:abi": "pnpm -F @peakpump/contracts-abi gen:abi",
    "gen:notice": "pnpm -F @peakpump/shared gen:notice",
    "gen:icons": "pnpm -F @peakpump/web gen:icons"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "tsx": "4.19.2",
    "turbo": "^2.1.0",
    "typescript": "5.6.3"
  }
}
